@model Memtly.Core.Models.PhotoGallery
@inject Memtly.Core.Helpers.IConfigHelper _config

@if (Model?.Images != null && Model.Images.Any())
{
    var imageLookup = Model.Images.ToLookup(x => x.State);
    var pendingItems = imageLookup[GalleryItemState.Pending];
    var approvedItems = imageLookup[GalleryItemState.Approved];

    @if (pendingItems != null && pendingItems.Any())
    {
        <div class="gallery-container gallery-container-pending">
            @{
                Model.FilterStateBy = GalleryItemState.Pending;
                Model.Images = pendingItems?.ToList();
            }
            <div class="row gallery-container-heading">
                <div class="col-12">
                    <h5>@(_localizer[_identity.IsOwner(User, Model!.Gallery!.Owner) || _identity.IsPrivilegedUser(User) ? "Pending_Uploads" : "Your_Pending_Uploads"].Value)</h5>
                </div>
            </div>
            <partial name="~/Views/Gallery/Layouts/Grid.cshtml" model="Model" />
        </div>
    }

    @if (approvedItems != null && approvedItems.Any())
    {
        <div class="gallery-container gallery-container-approved">
            @{
                Model.FilterStateBy = GalleryItemState.Approved;
                Model.Images = approvedItems?.ToList();
            }
            <div class="row gallery-container-heading mt-4">
                <div class="col-12">
                    <h5>@(_localizer["Approved_Gallery_Uploads"].Value)</h5>
                </div>
            </div>
            <partial name="~/Views/Gallery/Layouts/Grid.cshtml" model="Model" />
        </div>
    }
}